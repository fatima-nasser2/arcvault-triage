# Copy to .env and fill in.  Any OpenAI-compatible endpoint works.

# OpenAI (pay-as-you-go) — default. Use a NON-reasoning model: the workflow sends temperature 0,
# which reasoning models (gpt-5*, o*) reject.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your_key_here
LLM_MODEL=gpt-4.1-mini

# Groq free tier instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama running locally instead (no key needed):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# Offline plumbing test with scripts/mock_llm.py:
# LLM_BASE_URL=http://host.docker.internal:8787/v1
# LLM_API_KEY=mock
